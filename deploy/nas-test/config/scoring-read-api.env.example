# This account must be a NAS-Postgres read-only role limited to reputation_pilot.
# It must never be the scoring owner and it must not be given a URL containing a password.
PGHOST=REPLACE_WITH_SCORING_POSTGRES_SERVICE_NAME
PGPORT=5432
PGDATABASE=vebetter_scoring
PGUSER=REPLACE_WITH_READONLY_ROLE
PGPASSWORD_FILE=/run/secrets/scoring_reader_password
SCORE_API_ORIGIN=http://score-api:8789
# Select a single completed/validated/approved scoring_run UUID after manual review.
PUBLISHED_RUN_ID=REPLACE_WITH_REVIEWED_RUN_UUID
APP_ID_MAP_FILE=/run/config/app-id-map.json
