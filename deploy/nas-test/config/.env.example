# Browser-visible URL. With the default loopback proxy and an SSH tunnel:
NAS_TEST_INDEXER_URL=http://localhost:8088/indexer/api/v1
# Leave blank until a reviewed run and a tested app-ID mapping exist.
NAS_TEST_REPUTATION_URL=
# VIP-201 gas-payer URL used only by review/rating/vote/edit-review transactions.
# This is a public endpoint, not a funding-wallet credential.
REVIEW_DELEGATOR_URL=
# Needed only with compose.scores.yaml and the `scores` profile. This is the
# existing scoring-pilot's private Docker network, not a public database address.
SCORING_PILOT_NETWORK=REPLACE_WITH_EXISTING_PRIVATE_NETWORK_NAME
